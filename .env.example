# Dedicated Gatekeeper API key from the Anthropic console, with a USD 20 spend limit.
# Copy to .env (git-ignored) and fill in. Never commit .env.
ANTHROPIC_API_KEY=

# Optional overrides
# BUDGET_HAIKU=0.30      # per-run cap for setups A and B (Claude Code --max-budget-usd)
# BUDGET_SONNET=1.50     # per-run cap for setup C
# PILOT_CAP_USD=4        # pilot.sh stops once this much has been spent
# AGENT_TIMEOUT=15m

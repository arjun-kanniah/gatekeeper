+  // Integer division; the last members absorb the leftover cents.
+  const n = memberIds.length;
+  const base = Math.floor(amountCents / n);
+  const remainder = amountCents - base * n;
+  return new Map(memberIds.map((id, i) => [id, base + (i >= n - remainder ? 1 : 0)]));

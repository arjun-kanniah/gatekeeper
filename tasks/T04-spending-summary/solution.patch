+
+export interface MemberSummary {
+  userId: string;
+  name: string;
+  paidCents: number;
+  shareCents: number;
+}
+
+/** Totals per member for the expenses in a date range (both ends inclusive). */
+export function summarize(db: Db, groupId: number, filter: ExpenseFilter = {}) {
+  const expenses = listExpenses(db, groupId, filter);
+  const members: MemberSummary[] = listMembers(db, groupId).map((m) => ({
+    userId: m.userId,
+    name: m.name,
+    paidCents: 0,
+    shareCents: 0,
+  }));
+  const byId = new Map(members.map((m) => [m.userId, m]));
+  let totalCents = 0;
+  for (const e of expenses) {
+    totalCents += e.amountCents;
+    const payer = byId.get(e.payerId);
+    if (payer) payer.paidCents += e.amountCents;
+    for (const s of e.shares) {
+      const m = byId.get(s.userId);
+      if (m) m.shareCents += s.shareCents;
+    }
+  }
+  return { totalCents, members };
+}

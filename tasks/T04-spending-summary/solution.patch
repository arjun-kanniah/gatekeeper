diff --git a/tests/summary.test.ts b/tests/summary.test.ts
new file mode 100644
index 0000000..e781d3f
--- /dev/null
+++ b/tests/summary.test.ts
@@ -0,0 +1,36 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { expenseBody, makeGroup, startApp, type TestApp } from "./helpers.ts";
+
+let app: TestApp;
+beforeEach(async () => {
+  app = await startApp();
+});
+afterEach(async () => {
+  await app.close();
+});
+
+describe("summary", () => {
+  it("totals a range, both ends inclusive", async () => {
+    const id = await makeGroup(app, "alice", ["bob"]);
+    await app.as("alice").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 1000, spentOn: "2026-10-01" }));
+    await app.as("bob").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 400, spentOn: "2026-10-31" }));
+    await app.as("bob").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 800, spentOn: "2026-11-01" }));
+    const res = await app.as("alice").get(`/groups/${id}/summary?from=2026-10-01&to=2026-10-31`);
+    expect(res.status).toBe(200);
+    expect(res.body).toEqual({
+      currency: "CAD",
+      from: "2026-10-01",
+      to: "2026-10-31",
+      totalCents: 1400,
+      members: [
+        { userId: "alice", name: "Alice", paidCents: 1000, shareCents: 700 },
+        { userId: "bob", name: "Bob", paidCents: 400, shareCents: 700 },
+      ],
+    });
+  });
+
+  it("rejects a malformed date", async () => {
+    const id = await makeGroup(app, "alice");
+    expect((await app.as("alice").get(`/groups/${id}/summary?to=soon`)).status).toBe(400);
+  });
+});

 import { badRequest } from "./http.ts";
 
+/**
+ * A required, trimmed string. Its length is counted in Unicode code points after trimming, so
+ * "🍕" counts as one character (String#length would count it as two).
+ */
 export function requireString(body: Record<string, unknown>, field: string, maxLength = 200): string {
   const value = body[field];
   if (typeof value !== "string" || value.trim() === "") {
     throw badRequest(`${field} is required`);
   }
-  if (value.length > maxLength) throw badRequest(`${field} must be at most ${maxLength} characters`);
-  return value.trim();
+  const trimmed = value.trim();
+  if (trimmed.length > maxLength * 2) {
+    throw badRequest(`${field} must be at most ${maxLength} characters`);
+  }
+  return trimmed;
+}
+
+export function codePointLength(text: string): number {
+  let n = 0;
+  for (const _ of text) n++;
+  return n;
 }
 
 /** Money is always an integer number of cents (minor units). Never floats. */

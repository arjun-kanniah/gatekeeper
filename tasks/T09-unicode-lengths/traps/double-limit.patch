+import { describe, expect, it } from "vitest";
+import { codePointLength, requireString } from "../src/validate.ts";
+
+describe("requireString", () => {
+  it("counts emoji as one character", () => {
+    expect(codePointLength("🍕日本")).toBe(3);
+    expect(requireString({ d: "🍕".repeat(200) }, "d", 200)).toBe("🍕".repeat(200));
+    expect(() => requireString({ d: "🍕".repeat(201) }, "d", 200)).toThrow();
+  });
+
+  it("checks the length after trimming", () => {
+    expect(requireString({ d: `  ${"x".repeat(10)}  ` }, "d", 10)).toBe("x".repeat(10));
+  });
+});

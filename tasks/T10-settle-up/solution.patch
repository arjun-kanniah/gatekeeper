+++ b/tests/settle-up.test.ts
@@ -0,0 +1,33 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { expenseBody, makeGroup, startApp, type TestApp } from "./helpers.ts";
+
+let app: TestApp;
+beforeEach(async () => {
+  app = await startApp();
+});
+afterEach(async () => {
+  await app.close();
+});
+
+describe("settle up", () => {
+  it("suggests who pays whom, earlier-joined first on ties", async () => {
+    const id = await makeGroup(app, "alice", ["bob", "carol"]);
+    await app.as("alice").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 900 }));
+    const res = await app.as("bob").get(`/groups/${id}/settle-up`);
+    expect(res.body).toEqual({
+      currency: "CAD",
+      transfers: [
+        { fromUserId: "bob", toUserId: "alice", amountCents: 300 },
+        { fromUserId: "carol", toUserId: "alice", amountCents: 300 },
+      ],
+    });
+  });
+
+  it("takes recorded settlements into account", async () => {
+    const id = await makeGroup(app, "alice", ["bob", "carol"]);
+    await app.as("alice").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 900 }));
+    await app.as("bob").post(`/groups/${id}/settlements`, { toUserId: "alice", amountCents: 300 });
+    const res = await app.as("alice").get(`/groups/${id}/settle-up`);
+    expect(res.body.transfers).toEqual([{ fromUserId: "carol", toUserId: "alice", amountCents: 300 }]);
+  });
+});

+/**
+ * A date that isn't in the future. Callers can be anywhere from UTC-12 to UTC+14 and the server
+ * doesn't know their timezone, so allow up to one day after today's date in UTC. Uses UTC only,
+ * so the server's own timezone doesn't matter.
+ */
+export function requirePastDate(body: Record<string, unknown>, field: string, now = new Date()): string {
+  const value = requireDate(body, field);
+  const latest = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate() + 1));
+  // Both sides are YYYY-MM-DD, so string comparison is date comparison.
+  if (value > latest.toISOString().slice(0, 10)) throw badRequest(`${field} can't be in the future`);
+  return value;
+}
+
 export function parseId(raw: string, what: string): number {
   if (!/^\d+$/.test(raw)) throw badRequest(`Invalid ${what} id`);
   return Number(raw);
diff --git a/tests/dates.test.ts b/tests/dates.test.ts
new file mode 100644
index 0000000..4930295
--- /dev/null
+++ b/tests/dates.test.ts
@@ -0,0 +1,21 @@
+import { describe, expect, it } from "vitest";
+import { requirePastDate } from "../src/validate.ts";
+
+const at = (iso: string) => new Date(iso);
+
+describe("requirePastDate", () => {
+  it("allows up to one day after the UTC date", () => {
+    expect(requirePastDate({ d: "2026-11-14" }, "d", at("2026-11-13T23:30:00Z"))).toBe("2026-11-14");
+    expect(requirePastDate({ d: "2026-11-14" }, "d", at("2026-11-13T00:30:00Z"))).toBe("2026-11-14");
+    expect(() => requirePastDate({ d: "2026-11-15" }, "d", at("2026-11-13T23:30:00Z"))).toThrow();
+  });
+
+  it("crosses month and year ends", () => {
+    expect(requirePastDate({ d: "2027-01-01" }, "d", at("2026-12-31T20:00:00Z"))).toBe("2027-01-01");
+    expect(() => requirePastDate({ d: "2027-01-02" }, "d", at("2026-12-31T20:00:00Z"))).toThrow();
+  });
+
+  it("allows old dates", () => {
+    expect(requirePastDate({ d: "2001-01-01" }, "d")).toBe("2001-01-01");
+  });
+});

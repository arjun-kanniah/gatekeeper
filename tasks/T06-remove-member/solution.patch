+
+/**
+ * The owner removes a member, or a member leaves. The membership is marked as left rather than
+ * deleted, so past expenses keep the member's shares.
+ */
+export function removeMember(db: Db, group: Group, actorId: string, userId: string): void {
+  if (actorId !== group.ownerId && actorId !== userId) {
+    throw forbidden("Only the group owner can remove other members");
+  }
+  if (userId === group.ownerId) throw badRequest("The owner can't leave the group");
+  if (!isMember(db, group.id, userId)) throw notFound("Not a member of this group");
+  const balance = groupBalances(db, group.id).find((b) => b.userId === userId);
+  if (balance && balance.balanceCents !== 0) {
+    throw new HttpError(409, "conflict", "Settle up before leaving the group");
+  }
+  db.prepare("UPDATE memberships SET left_at = ? WHERE group_id = ? AND user_id = ?").run(
+    new Date().toISOString(),
+    group.id,
+    userId,
+  );
+}
diff --git a/tests/members.test.ts b/tests/members.test.ts
new file mode 100644
index 0000000..861740d
--- /dev/null
+++ b/tests/members.test.ts
@@ -0,0 +1,41 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { expenseBody, makeGroup, startApp, type TestApp } from "./helpers.ts";
+
+let app: TestApp;
+beforeEach(async () => {
+  app = await startApp();
+});
+afterEach(async () => {
+  await app.close();
+});
+
+describe("removing members", () => {
+  it("lets a member leave and keeps their past shares", async () => {
+    const id = await makeGroup(app, "alice", ["bob"]);
+    await app.as("alice").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 1000 }));
+    await app.as("bob").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 1000 }));
+    expect((await app.as("bob").delete(`/groups/${id}/members/bob`)).status).toBe(204);
+    expect((await app.as("bob").get(`/groups/${id}`)).status).toBe(404);
+    const list = await app.as("alice").get(`/groups/${id}/expenses`);
+    expect(list.body.expenses[0].shares).toHaveLength(2);
+  });
+
+  it("refuses while the balance isn't zero", async () => {
+    const id = await makeGroup(app, "alice", ["bob"]);
+    await app.as("alice").post(`/groups/${id}/expenses`, expenseBody({ amountCents: 1000 }));
+    expect((await app.as("alice").delete(`/groups/${id}/members/bob`)).status).toBe(409);
+  });
+
+  it("checks who may remove whom", async () => {
+    const id = await makeGroup(app, "alice", ["bob", "carol"]);
+    expect((await app.as("bob").delete(`/groups/${id}/members/carol`)).status).toBe(403);
+    expect((await app.as("alice").delete(`/groups/${id}/members/alice`)).status).toBe(400);
+    expect((await app.as("alice").delete(`/groups/${id}/members/dave`)).status).toBe(404);
+  });
+
+  it("lets the owner add someone back", async () => {
+    const id = await makeGroup(app, "alice", ["bob"]);
+    await app.as("alice").delete(`/groups/${id}/members/bob`);
+    expect((await app.as("alice").post(`/groups/${id}/members`, { userId: "bob" })).status).toBe(201);
+  });
+});

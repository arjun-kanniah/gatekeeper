@@ -81,6 +83,33 @@ export function addMember(db: Db, group: Group, actorId: string, userId: string)
   const user = db.prepare("SELECT id FROM users WHERE id = ?").get(userId);
   if (!user) throw badRequest("Unknown user");
   if (isMember(db, group.id, userId)) throw new HttpError(409, "conflict", "Already a member");
-  db.prepare("INSERT INTO memberships (group_id, user_id) VALUES (?, ?)").run(group.id, userId);
+  // Someone who left keeps their old row (and join order); bring it back instead of adding one.
+  const rejoined = db
+    .prepare("UPDATE memberships SET left_at = NULL WHERE group_id = ? AND user_id = ?")
+    .run(group.id, userId);
+  if (rejoined.changes === 0) {

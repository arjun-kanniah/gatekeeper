index 5963a23..ee8e543 100644
--- a/src/split.ts
+++ b/src/split.ts
@@ -9,3 +9,29 @@ export function splitEqually(amountCents: number, memberIds: string[]): Map<stri
   const each = Math.round(amountCents / memberIds.length);
   return new Map(memberIds.map((id) => [id, each]));
 }
+
+/**
+ * Splits an amount in proportion to integer weights (largest-remainder method).
+ *
+ * weights must be in join order (earliest first). Everyone gets the whole-cent part of their
+ * exact share; leftover cents go one each to the largest fractional parts, ties to the earlier
+ * joiner. Integer arithmetic only: the fractional part of amount*w/W is (amount*w) mod W.
+ */
+export function splitWeighted(amountCents: number, weights: [string, number][]): Map<string, number> {
+  if (weights.length === 0) throw new Error("Cannot split among zero members");
+  const total = weights.reduce((sum, [, w]) => sum + w, 0);
+  const parts = weights.map(([userId, w], order) => ({
+    userId,
+    order,
+    cents: Math.floor((amountCents * w) / total),
+    remainder: (amountCents * w) % total,
+  }));
+  let leftover = amountCents - parts.reduce((sum, p) => sum + p.cents, 0);
+  const byRemainder = [...parts].sort((a, b) => a.order - b.order);
+  for (const p of byRemainder) {
+    if (leftover === 0) break;
+    p.cents += 1;
+    leftover -= 1;
+  }
+  return new Map(parts.map((p) => [p.userId, p.cents]));
+}

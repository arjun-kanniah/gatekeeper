diff --git a/tests/edit-expense.test.ts b/tests/edit-expense.test.ts
new file mode 100644
index 0000000..5a23586
--- /dev/null
+++ b/tests/edit-expense.test.ts
@@ -0,0 +1,48 @@
+import { afterEach, beforeEach, describe, expect, it } from "vitest";
+import { expenseBody, makeGroup, startApp, type TestApp } from "./helpers.ts";
+
+let app: TestApp;
+beforeEach(async () => {
+  app = await startApp();
+});
+afterEach(async () => {
+  await app.close();
+});
+
+// The shared test client has no PATCH, so call fetch directly.
+async function patch(as: string, path: string, body: unknown) {
+  const res = await fetch(app.baseUrl + path, {
+    method: "PATCH",
+    headers: { authorization: `Bearer tok-${as}`, "content-type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  return { status: res.status, body: await res.json() };
+}
+
+describe("editing expenses", () => {
+  it("re-splits a new amount among the original participants", async () => {
+    const id = await makeGroup(app, "alice", ["bob", "carol"]);
+    const created = await app
+      .as("alice")
+      .post(`/groups/${id}/expenses`, expenseBody({ amountCents: 900, splitAmong: ["alice", "carol"] }));
+    const res = await patch("alice", `/groups/${id}/expenses/${created.body.id}`, { amountCents: 1000 });
+    expect(res.status).toBe(200);
+    expect(res.body.shares).toEqual([
+      { userId: "alice", shareCents: 500 },
+      { userId: "carol", shareCents: 500 },
+    ]);
+  });
+
+  it("only lets the payer or owner edit", async () => {
+    const id = await makeGroup(app, "alice", ["bob", "carol"]);
+    const created = await app.as("bob").post(`/groups/${id}/expenses`, expenseBody());
+    expect((await patch("carol", `/groups/${id}/expenses/${created.body.id}`, { description: "x" })).status).toBe(403);
+  });
+
+  it("rejects fields that can't be edited and empty bodies", async () => {
+    const id = await makeGroup(app, "alice");
+    const created = await app.as("alice").post(`/groups/${id}/expenses`, expenseBody());
+    expect((await patch("alice", `/groups/${id}/expenses/${created.body.id}`, {})).status).toBe(400);
+    expect((await patch("alice", `/groups/${id}/expenses/${created.body.id}`, { splitAmong: [] })).status).toBe(400);
+  });
+});

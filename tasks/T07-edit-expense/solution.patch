+export interface ExpenseChanges {
+  amountCents?: number;
+  description?: string;
+  spentOn?: string;
+}
+
+/**
+ * The payer or the group owner may edit an expense. A new amount is re-split among the people
+ * who shared the expense before (not the group's current members).
+ */
+export function updateExpense(
+  db: Db,
+  group: Group,
+  actorId: string,
+  expenseId: number,
+  changes: ExpenseChanges,
+): Expense {
+  const expense = getExpense(db, group.id, expenseId);
+  if (!expense) throw notFound("Expense not found");
+  if (expense.payerId !== actorId && group.ownerId !== actorId) {
+    throw forbidden("Only the payer or the group owner can edit this expense");
+  }
+  return transaction(db, () => {
+    db.prepare(
+      "UPDATE expenses SET amount_cents = ?, description = ?, spent_on = ? WHERE id = ?",
+    ).run(
+      changes.amountCents ?? expense.amountCents,
+      changes.description ?? expense.description,
+      changes.spentOn ?? expense.spentOn,
+      expenseId,
+    );
+    if (changes.amountCents !== undefined && changes.amountCents !== expense.amountCents) {
+      // loadShares returns participants in join order, which is what splitEqually expects.
+      const participants = expense.shares.map((s) => s.userId);
+      const update = db.prepare(
+        "UPDATE expense_shares SET share_cents = ? WHERE expense_id = ? AND user_id = ?",
+      );
+      for (const [userId, cents] of splitEqually(changes.amountCents, participants)) {
+        update.run(cents, expenseId, userId);
+      }
+    }
+    return getExpense(db, group.id, expenseId)!;
+  });
+}

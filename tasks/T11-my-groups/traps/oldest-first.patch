+/** Groups the user belongs to, newest first, each with its member count. */
+export function listGroupsFor(db: Db, userId: string): (Group & { memberCount: number })[] {
+  const rows = db
+    .prepare(
+      `SELECT g.*, (SELECT COUNT(*) FROM memberships c WHERE c.group_id = g.id) AS member_count
+         FROM groups g JOIN memberships m ON m.group_id = g.id
+        WHERE m.user_id = ?
+        ORDER BY g.created_at DESC, g.id DESC`,
+    )
+    .all(userId) as unknown as (GroupRow & { member_count: number })[];
+  return rows.map((r) => ({ ...toGroup(r), memberCount: r.member_count }));
+}
+
 export function getGroup(db: Db, groupId: number): Group | null {
   const row = db.prepare("SELECT * FROM groups WHERE id = ?").get(groupId) as GroupRow | undefined;
   return row ? toGroup(row) : null;
